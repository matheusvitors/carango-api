{
	"name": "carango-api",
	"version": "1.0.0",
	"main": "dist/server.js",
	"scripts": {
		"start": "node dist/server.js",
		"build": "tsup src",
		"dev": "dotenv -e .env nodemon src/server.ts",
		"upgrade": "ncu -u && npm i",
		"test": "dotenv -e .env.tests vitest run --coverage",
		"test:watch": "vitest --ui",
		"test:unit:watch": "vitest --dir src --ui",
		"test:e2e:watch": "vitest --dir __tests__ --ui",
		"test:unit": "vitest run --dir src",
		"test:e2e": "vitest run --dir __tests__",
		"migrate": "npx prisma migrate dev",
		"fix-ssl": "set NODE_TLS_REJECT_UNAUTHORIZED=0"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": "",
	"dependencies": {
		"@prisma/client": "^6.12.0",
		"bcrypt": "^6.0.0",
		"cors": "^2.8.5",
		"dotenv": "^17.2.1",
		"express": "^5.1.0",
		"helmet": "^8.1.0",
		"jsonwebtoken": "^9.0.2",
		"ms": "^2.1.3",
		"rate-limiter-flexible": "^7.1.1",
		"uuidv7": "^1.0.2",
		"zod": "^4.0.10"
	},
	"devDependencies": {
		"@types/bcrypt": "^6.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^24.1.0",
		"@types/supertest": "^6.0.3",
		"@vitest/ui": "3.2.4",
		"dotenv-cli": "^9.0.0",
		"nodemon": "^3.1.10",
		"prisma": "^6.12.0",
		"supertest": "^7.1.4",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"tsup": "^8.5.0",
		"tsx": "^4.20.3",
		"typescript": "^5.8.3",
		"vite": "^7.0.6",
		"vitest": "^3.2.4"
	}
}
