{
	"name": "carango-api",
	"version": "1.0.0",
	"main": "dist/server.js",
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"scripts": {
		"start": "node dist/server.js",
		"build": "tsup src",
		"dev": "dotenv -e .env nodemon src/server.ts",
		"upgrade": "ncu -u && npm i",
		"test": "vitest run --coverage",
		"test:watch": "vitest --ui",
		"test:unit:watch": "vitest --dir src --ui",
		"test:e2e:watch": "dotenv -e .env.test npm run clear-db && vitest --dir __tests__ --ui",
		"test:unit:local": "dotenv -v TEST_TYPE=unit -- npm run test:unit",
		"test:unit": "vitest run --dir src",
		"test:e2e": "vitest run --dir __tests__",
		"migrate": "npx prisma migrate dev",
		"clear-db": "npx prisma migrate reset --force",
		"fix-ssl": "set NODE_TLS_REJECT_UNAUTHORIZED=0"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": "",
	"dependencies": {
		"@prisma/client": "^6.18.0",
		"bcrypt": "^6.0.0",
		"cors": "^2.8.5",
		"dotenv": "^17.2.3",
		"express": "^5.1.0",
		"helmet": "^8.1.0",
		"jsonwebtoken": "^9.0.2",
		"ms": "^2.1.3",
		"randexp": "^0.5.3",
		"rate-limiter-flexible": "^8.1.0",
		"uuidv7": "^1.0.2",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.1.0",
		"@types/bcrypt": "^6.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^24.9.1",
		"@types/supertest": "^6.0.3",
		"@vitest/coverage-v8": "^4.0.1",
		"@vitest/ui": "4.0.1",
		"dotenv-cli": "^10.0.0",
		"nodemon": "^3.1.10",
		"prisma": "^6.18.0",
		"supertest": "^7.1.4",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"tsup": "^8.5.0",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"vite": "^7.1.11",
		"vitest": "^4.0.1"
	}
}
